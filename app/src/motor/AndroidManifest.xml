<?xml version="1.0" encoding="utf-8"?>
<!-- Editor (Motor 3D): o app de criar o jogo -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- assistente de IA e "Abrir de link" -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Motor 3D" tools:replace="android:label">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
